check("string.sub('abc', 31.5)", function() return string.sub("abc", 31.5) end, function() return string.sub("abc", hide(31.5)) end)
check("string.sub('abc', 1, 1e300)", function() return string.sub("abc", 1, 1e300) end, function() return string.sub("abc", 1, hide(1e300)) end)
check("string.sub('abc', 1, 0/0)", function() return string.sub("abc", 1, 0/0) end, function() return string.sub("abc", 1, hide(0/0)) end)
check("string.sub('abc', 1, -math.huge)", function() return string.sub("abc", 1, -math.huge) end, function() return string.sub("abc", 1, hide(-math.huge)) end)
check("string.sub('abc', 1, 2^31)", function() return string.sub("abc", 1, 2^31) end, function() return string.sub("abc", 1, hide(2^31)) end)
check("string.sub('abc', 1, -2^31 - 1)", function() return string.sub("abc", 1, -2^31 - 1) end, function() return string.sub("abc", 1, hide(-2^31 - 1)) end)
check("string.sub('abc', 1, 2^31 - 0.5)", function() return string.sub("abc", 1, 2^31 - 0.5) end, function() return string.sub("abc", 1, hide(2^31 - 0.5)) end)
check("string.sub('abc', 1, -2^31)", function() return string.sub("abc", 1, -2^31) end, function() return string.sub("abc", 1, hide(-2^31)) end)
check("string.sub('abc', 1, 31.5)", function() return string.sub("abc", 1, 31.5) end, function() return string.sub("abc", 1, hide(31.5)) end)

-- field and width that each fit in int but overflow when added
check("bit32.extract(-1, 2147483647, 2147483647)", function() return bit32.extract(-1, 2147483647, 2147483647) end, function() return bit32.extract(-1, hide(2147483647), hide(2147483647)) end)
check("bit32.extract(n, 2147483647, 2147483647)", function() return bit32.extract(hide(-1), 2147483647, 2147483647) end, function() return bit32.extract(hide(-1), hide(2147483647), hide(2147483647)) end)
check("bit32.replace(0, -1, 2147483647, 2147483647)", function() return bit32.replace(0, -1, 2147483647, 2147483647) end, function() return bit32.replace(0, -1, hide(2147483647), hide(2147483647)) end)

-- Field and width that are each in range but overflow when added must fail like the library does, including in native code
local function call(fn, ...)
  return fn(...)
end

local fieldWidths = {
  {2147483647, 2147483647}, {2147483647, 1}, {1, 2147483647}, {-2147483648, 2147483647}, {2147483647, -2147483648},
  {16, 17}, {31, 2}, {0, 33}, {-1, 1}, {0, 0}, {0, 32}, {31, 1}, {8, 8},
}

for _, fw in fieldWidths do
  local f, w = fw[1], fw[2]
  local name = `({f}, {w})`

  check("extract" .. name, function(n, f, w) return bit32.extract(n, f, w) end, function(n, f, w) return call(bit32.extract, n, f, w) end, 0xffffffff, f, w)
  check("replace" .. name, function(n, v, f, w) return bit32.replace(n, v, f, w) end, function(n, v, f, w) return call(bit32.replace, n, v, f, w) end, 0, 0xffffffff, f, w)
end

return('OK')
