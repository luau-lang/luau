print("testing compile-time folding of out-of-range float-to-int conversions")

-- Each call with literal arguments, which the compiler may fold or specialize, must match the same call
-- with the arguments hidden from the compiler, which is evaluated at runtime.
local opaque = {}
local function hide(v)
  opaque[1] = v
  return opaque[1]
end

local function same(a, b)
  return a == b or (a ~= a and b ~= b)
end

local function message(err)
  return (string.gsub(tostring(err), "^[^:]*:%d+: ", ""))
end

local function check(name, constant, runtime, ...)
  local cok, cv = pcall(constant, ...)
  local rok, rv = pcall(runtime, ...)
  assert(cok == rok, name .. ": " .. tostring(cv) .. " vs " .. tostring(rv))
  assert(type(cv) == type(rv), name)
  if cok then
    assert(same(cv, rv), name .. ": " .. tostring(cv) .. " ~= " .. tostring(rv))
  else
    assert(message(cv) == message(rv), name .. ": " .. message(cv) .. " ~= " .. message(rv))
  end
end

